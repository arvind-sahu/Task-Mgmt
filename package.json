{
  "name": "task-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:wait": "docker compose wait db",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed:dummy": "npx tsx scripts/seed-dummy-users.ts",
    "db:studio": "prisma studio",
    "db:start": "npm run db:up && npm run db:wait && npm run db:push",
    "dev": "next dev",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy",
    "sst:deploy:prod": "sst deploy --stage prod",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "s3:cors": "aws s3api put-bucket-cors --bucket tasker-prod-s3 --cors-configuration file://scripts/s3-cors.json"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@prisma/client": "^5.14.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-query": "^5.50.0",
    "@tiptap/extension-bullet-list": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-mention": "^3.26.1",
    "@tiptap/extension-ordered-list": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/next": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "@trpc/server": "^11.0.0-rc.446",
    "bcryptjs": "^2.4.3",
    "geist": "^1.3.0",
    "isomorphic-dompurify": "^3.17.0",
    "next": "^14.2.4",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^2.2.1",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "prisma": "^5.14.0",
    "sst": "^3.3.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3",
    "vitest": "^2.1.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.37.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.3.0"
}
