// Prisma schema for the Task Management & Collaboration Tool.
// Database: PostgreSQL (Supabase in production).
// Auth: NextAuth.js w/ Credentials provider (email + password) — `password`
// is stored as a bcrypt hash directly on `User`.

generator client {
    provider      = "prisma-client-js"
    // Ship engine binaries for dev ("native"), Docker (musl), and AWS Lambda
    // on Amazon Linux (rhel-openssl-3.0.x). Without rhel, Prisma fails at runtime
    // on CloudFront/Lambda even though `prisma generate` works on GitHub Actions.
    binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    // `directUrl` lets Prisma migrate bypass Supabase's PgBouncer pool which
    // does not support prepared statements / DDL.
    directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// NextAuth.js models
// ---------------------------------------------------------------------------

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

/// Represents an account in the system. The `password` column holds a bcrypt
/// hash and is only used by the Credentials provider — OAuth users keep it
/// null. Profile fields (`bio`, `timezone`) are surfaced on the /profile page.
model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String? // OAuth / external avatar URL
    imageKey      String? // S3 object key under user-images/
    password      String? // bcrypt hash; null for OAuth-only accounts
    bio           String?
    /// Organization the user belongs to (used to scope employee search and invites).
    companyName   String?
    jobTitle      String?
    department    String?
    timezone      String?   @default("UTC")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts          Account[]
    sessions          Session[]
    ownedProjects     Project[]       @relation("ProjectOwner")
    memberships       ProjectMember[]
    createdTasks      Task[]          @relation("TaskCreator")
    assignedTasks     Task[]          @relation("TaskAssignees")
    comments            Comment[]
    uploadedAttachments TaskAttachment[]
    notifications       Notification[]
    loginAudits         LoginAudit[]
    invitesSent         ProjectInvite[] @relation("InvitesSent")

    @@index([companyName])
}

enum SprintPlan {
    WEEKLY
    BIWEEKLY
    CUSTOM_DAY
}

/// Top-level container that groups tasks. Owned by a single user but can have
/// many members through `ProjectMember`.
model Project {
    id          String   @id @default(cuid())
    name        String
    description String?
    color       String   @default("#6366F1") // indigo-500 default
    sprintPlan  SprintPlan @default(WEEKLY)
    sprintStartDayOfWeek Int? // 0=Sun … 6=Sat, required when sprintPlan is CUSTOM_DAY
    sprintDurationWeeks Int      @default(1)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    ownerId String
    owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

    members ProjectMember[]
    tasks   Task[]
    sprints Sprint[]
    tags    Tag[]
    invites ProjectInvite[]

    @@index([ownerId])
}

enum ProjectRole {
    OWNER
    ADMIN
    MEMBER
}

/// Join table mapping users to projects with a role. The `(userId, projectId)`
/// tuple is unique so a user can only be a member of a given project once.
model ProjectMember {
    id        String      @id @default(cuid())
    role      ProjectRole @default(MEMBER)
    joinedAt  DateTime    @default(now())

    userId    String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([userId, projectId])
    @@index([projectId])
}

enum TaskPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

enum TaskStatus {
    BACKLOG
    TODO
    IN_PROGRESS
    IN_REVIEW
    DONE
}

enum EmailOtpPurpose {
    LOGIN_2FA
    FORGOT_PASSWORD
    SIGNUP_VERIFY
}

enum NotificationType {
    TASK_ASSIGNED
    TASK_COMMENT
    TASK_DUE
    PROJECT_INVITE
}

enum InviteStatus {
    PENDING
    ACCEPTED
    DECLINED
    EXPIRED
}

enum LeadRequestType {
    DEMO_REQUEST
    CONTACT_SALES
    NEWSLETTER_SIGNUP
}

enum LeadRequestStatus {
    NEW
    IN_PROGRESS
    CONTACTED
    CLOSED
}

enum LeadRequestEmailStatus {
    QUEUED
    SENT
    FAILED
    SKIPPED
}

/// Core unit of work. Belongs to a Project, optionally has a deadline, can be
/// assigned to many users, and can be tagged.
model Task {
    id          String       @id @default(cuid())
    title       String
    description String?
    status      TaskStatus   @default(TODO)
    priority    TaskPriority @default(MEDIUM)
    deadline    DateTime?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    projectId   String
    project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
    sprintId    String?
    sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
    creatorId   String
    creator     User         @relation("TaskCreator", fields: [creatorId], references: [id])

    assignees User[]    @relation("TaskAssignees")
    tags      Tag[]
    comments    Comment[]
    attachments TaskAttachment[]

    @@index([projectId])
    @@index([sprintId])
    @@index([creatorId])
    @@index([status])
}

model Sprint {
    id        String   @id @default(cuid())
    name      String
    startDate DateTime
    endDate   DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    tasks     Task[]

    @@index([projectId, startDate])
    @@index([projectId, endDate])
}

/// Per-project, color-coded label. Names are unique within a project.
model Tag {
    id        String   @id @default(cuid())
    name      String
    color     String   @default("#94A3B8") // slate-400
    createdAt DateTime @default(now())

    projectId String
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    tasks Task[]

    @@unique([projectId, name])
    @@index([projectId])
}

/// Lightweight discussion thread on a task.
model Comment {
    id        String   @id @default(cuid())
    body      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    taskId   String
    task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
    authorId String
    author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    attachments TaskAttachment[]

    @@index([taskId])
}

/// Files (images, PDFs) attached to a task description or a comment.
model TaskAttachment {
    id         String   @id @default(cuid())
    fileName   String
    mimeType   String
    /// Legacy inline data URL or old public S3 URL — prefer storageKey for new uploads.
    dataUrl    String?  @db.Text
    /// S3 object key under tasks-attachments/
    storageKey String?
    createdAt  DateTime @default(now())

    taskId    String?
    task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
    commentId String?
    comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

    uploaderId String
    uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

    @@index([taskId])
    @@index([commentId])
}

/// One-time-passwords sent via email for 2FA and password reset flows.
model EmailOtp {
    id         String          @id @default(cuid())
    email      String
    purpose    EmailOtpPurpose
    codeHash   String
    expiresAt  DateTime
    consumedAt DateTime?
    createdAt  DateTime        @default(now())

    @@index([email, purpose])
    @@index([expiresAt])
}

model Notification {
    id        String           @id @default(cuid())
    userId    String
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      NotificationType
    title     String
    message   String
    link      String?
    readAt    DateTime?
    createdAt DateTime         @default(now())

    @@index([userId, readAt])
    @@index([userId, createdAt])
}

model ProjectInvite {
    id          String       @id @default(cuid())
    email       String
    role        ProjectRole  @default(MEMBER)
    status      InviteStatus @default(PENDING)
    token       String       @unique @default(cuid())
    expiresAt   DateTime
    createdAt   DateTime     @default(now())
    respondedAt DateTime?

    projectId   String
    project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    invitedById String
    invitedBy   User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

    @@index([email, status])
    @@index([projectId])
}

model LeadRequest {
    id              String                 @id @default(cuid())
    requestId       String                 @unique @db.VarChar(10)
    type            LeadRequestType
    status          LeadRequestStatus      @default(NEW)
    emailStatus     LeadRequestEmailStatus @default(QUEUED)
    fullName        String?
    workEmail       String
    companyRole     String?
    companySize     String?
    message         String?
    source          String?
    emailSentAt     DateTime?
    emailError      String?
    createdAt       DateTime               @default(now())
    updatedAt       DateTime               @updatedAt

    @@index([type, createdAt])
    @@index([status, createdAt])
    @@index([emailStatus, createdAt])
}

model LoginAudit {
    id            String   @id @default(cuid())
    userId        String
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    method        String
    ipAddress     String?
    userAgent     String?
    deviceType    String?
    deviceOs      String?
    deviceLabel   String?
    locationLabel String?
    createdAt     DateTime @default(now())

    @@index([userId, createdAt])
}

model RateLimitHit {
    id        String   @id @default(cuid())
    key       String
    createdAt DateTime @default(now())

    @@index([key, createdAt])
}
