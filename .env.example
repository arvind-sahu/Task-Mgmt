# Copy to .env and fill in real values. Do NOT commit .env.

# Supabase → Project Settings → Database → Connection string (URI)
# Pooled (6543) for app runtime; direct (5432) for Prisma migrations.
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000 — Prod: your CloudFront URL after deploy
NEXTAUTH_URL=http://localhost:3000

# AWS credentials: use `aws configure` only — never put keys in this file.
