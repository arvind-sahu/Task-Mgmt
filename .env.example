# Copy to .env

# --- Local dev (recommended — ~10–50 ms queries) ---
# Run once: npm run db:start
# DATABASE_URL=postgresql://postgres:password@localhost:5432/demo
# DIRECT_URL=postgresql://postgres:password@localhost:5432/demo

# --- Supabase (production / remote dev — each query adds ~1–3 s network latency) ---
# Supabase → Project Settings → Database → Connection string (URI)
# Transaction pooler (port 6543) — app runtime / Lambda
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Session pooler (port 5432) — Prisma migrations / db push
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# openssl rand -base64 32
NEXTAUTH_SECRET=

# Local: http://localhost:3000 — Prod: https://www.taskers.in
NEXTAUTH_URL=http://localhost:3000
APP_ENV=dev

# Custom domain (GoDaddy + CloudFront). ACM cert must be in us-east-1.
CUSTOM_DOMAIN=www.taskers.in
# ACM_CERT_ARN=arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERT_ID

# SMTP config for email OTP (2FA + forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional OAuth (buttons hidden until both id + secret are set)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# GitHub: Settings → Developer settings → OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# S3 file storage (profile photos + task attachments) — separate from deploy IAM keys
# Bucket folders: user-images/ and tasks-attachments/
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=tasker-prod-s3
